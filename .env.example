# ============================================================
# RENU — 環境變數範本
# 用法：複製這個檔成 .env.local，把值填進去（.env.local 已被 gitignore，不會上傳）
# ============================================================

# ---- 網站正式網址（SEO 用，等業主 domain 來了再改）----
# 例：https://washshoes.vercel.app 或 https://www.你的網域.com.tw
NEXT_PUBLIC_SITE_URL=

# ============================================================
# Firebase — 公開設定（來自 Firebase 主控台 → 專案設定 → Web 應用程式）
# 這 6 個是「公開」值，放在前端沒問題
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Firebase Admin — 機密！（來自 專案設定 → 服務帳戶 → 產生新的私密金鑰 的 JSON）
# 絕對不要 commit、不要貼到公開地方。只放在 .env.local 與 Vercel 環境變數。
# ------------------------------------------------------------
# 整包 JSON 放同一個變數。兩種格式都吃：
#   1. 直接貼 JSON（要壓成一行，且整段用單引號包住）
#   2. base64 編碼後貼上 —— 建議用這種，沒有換行與引號的困擾：
#        base64 -w0 serviceAccount.json      # Linux
#        certutil -encode -f serviceAccount.json tmp.b64   # Windows
# ============================================================
FIREBASE_SERVICE_ACCOUNT_KEY=

# ============================================================
# Vercel Blob — 圖片上傳（機密！）
# 後台上傳的案例圖／首頁 hero 圖都存在這裡，前台直接讀公開 CDN URL。
# ------------------------------------------------------------
# store 必須是 **public** 存取模式（建立後不能改）：
#   Vercel → Storage → Create Database → Blob → Access 選 Public
# 連到專案後，Vercel 會自動注入這個變數到 Production/Preview；
# 本機開發要自己從 store 的 .env.local 頁籤複製過來。
# 注意：一個專案只接一個 Blob store，接兩個變數會撞名。
# ============================================================
BLOB_READ_WRITE_TOKEN=
